{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing subscription status",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "isPro": {
          "type": "boolean",
          "description": "Whether the user has unlocked the Pro version"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user account was created"
        }
      },
      "required": ["email", "isPro", "createdAt"]
    },
    "PromptHistory": {
      "title": "Prompt History",
      "description": "User's saved prompt history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "niche": { "type": "string" },
        "audience": { "type": "string" },
        "promptText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "niche", "audience", "promptText", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and their pro status."
    },
    "/users/{userId}/prompts/{promptId}": {
      "schema": {
        "$ref": "#/entities/PromptHistory"
      },
      "description": "Stores the generated prompts saved by the user."
    }
  }
}
